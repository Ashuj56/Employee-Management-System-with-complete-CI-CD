# ─────────────────────────────────────────────────────────────────────────────
# k8s/secret.yaml.template
# Template for storing the Azure SQL password as a Kubernetes Secret.
# Copy this file to k8s/secret.yaml and replace the placeholder.
#
#   cp k8s/secret.yaml.template k8s/secret.yaml
#   echo -n "YourActualPassword" | base64
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: ems-backend-secret
  namespace: ems
  labels:
    app.kubernetes.io/name: ems-backend
    app.kubernetes.io/part-of: employee-management-system
type: Opaque
data:
  # Replace with base64 encoded password: echo -n "YourPassword" | base64
  DB_PASSWORD: YOUR_BASE64_ENCODED_PASSWORD_HERE
